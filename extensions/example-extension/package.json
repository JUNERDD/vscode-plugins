{
  "name": "@vscode-plugins/example-extension",
  "displayName": "Example Extension",
  "version": "0.0.0",
  "private": true,
  "description": "Starter VS Code extension package for this monorepo.",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm run clean && rolldown -c",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "format": "oxfmt --write \"src/**/*.ts\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check \"src/**/*.ts\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint src rolldown.config.mjs vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vscode-plugins/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.9",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "rolldown": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-plugins-example.helloWorld",
        "title": "Example Extension: Hello World"
      }
    ]
  },
  "activationEvents": [
    "onCommand:vscode-plugins-example.helloWorld"
  ],
  "engines": {
    "vscode": "^1.125.0"
  }
}
