{
  "name": "commit-tree",
  "displayName": "%extension.displayName%",
  "version": "0.0.1",
  "private": true,
  "description": "%extension.description%",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNERDD/vscode-plugins.git",
    "directory": "extensions/commit-tree"
  },
  "publisher": "vscode-plugins",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm run clean && rolldown -c",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"l10n/*.json\" \"package.nls*.json\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"l10n/*.json\" \"package.nls*.json\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint src test rolldown.config.mjs vitest.config.ts",
    "package:vsix": "pnpm run build && pnpm exec vsce package --no-dependencies",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
    "@vscode-plugins/pierre-diff-viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "rolldown": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "vscode-plugins-commit-tree.openCommit",
        "title": "%command.openCommit.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "vscode-plugins-commit-tree.openFromHistory",
        "title": "%command.openFromHistory.title%",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-plugins-commit-tree.openFromHistory",
          "when": "resourceScheme == scm-history-item",
          "group": "navigation@0"
        }
      ],
      "scm/title": [
        {
          "command": "vscode-plugins-commit-tree.openCommit",
          "when": "scmProvider == git",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "commitTree.view.defaultStyle": {
          "type": "string",
          "enum": [
            "split",
            "unified"
          ],
          "default": "split",
          "description": "%configuration.defaultStyle.description%"
        },
        "commitTree.view.overflow": {
          "type": "string",
          "enum": [
            "scroll",
            "wrap"
          ],
          "default": "scroll",
          "description": "%configuration.overflow.description%"
        },
        "commitTree.view.treeWidth": {
          "type": "number",
          "minimum": 180,
          "maximum": 600,
          "default": 280,
          "description": "%configuration.treeWidth.description%"
        },
        "commitTree.view.flattenEmptyDirectories": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.flattenEmptyDirectories.description%"
        },
        "commitTree.view.stickyHeaders": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.stickyHeaders.description%"
        },
        "commitTree.view.maxPatchSizeBytes": {
          "type": "number",
          "minimum": 1048576,
          "maximum": 104857600,
          "default": 26214400,
          "description": "%configuration.maxPatchSizeBytes.description%"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:vscode-plugins-commit-tree.openCommit",
    "onCommand:vscode-plugins-commit-tree.openFromHistory"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "engines": {
    "vscode": "^1.105.0"
  }
}
