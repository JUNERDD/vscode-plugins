{
  "name": "diff-preview",
  "displayName": "%extension.displayName%",
  "version": "0.0.1",
  "private": true,
  "description": "%extension.description%",
  "categories": [
    "Other"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNERDD/vscode-plugins.git",
    "directory": "extensions/diff-preview"
  },
  "publisher": "vscode-plugins",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm run clean && rolldown -c",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"l10n/*.json\" \"package.nls*.json\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"l10n/*.json\" \"package.nls*.json\" rolldown.config.mjs vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint src test rolldown.config.mjs vitest.config.ts",
    "package:vsix": "pnpm run build && pnpm exec vsce package --no-dependencies",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vscode-plugins/pierre-diff-viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "rolldown": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "vscode-plugins-diff-preview.openPreview",
        "title": "%command.openPreview.title%"
      },
      {
        "command": "vscode-plugins-diff-preview.openPreviewToSide",
        "title": "%command.openPreviewToSide.title%"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscode-plugins-diff-preview.preview",
        "displayName": "%customEditor.preview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.diff"
          },
          {
            "filenamePattern": "*.patch"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-plugins-diff-preview.openPreviewToSide",
          "when": "resourceExtname == .diff || resourceExtname == .patch",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "diffPreview.view.defaultStyle": {
          "type": "string",
          "enum": [
            "split",
            "unified"
          ],
          "default": "split",
          "description": "%configuration.defaultStyle.description%"
        },
        "diffPreview.view.overflow": {
          "type": "string",
          "enum": [
            "scroll",
            "wrap"
          ],
          "default": "scroll",
          "description": "%configuration.overflow.description%"
        },
        "diffPreview.view.themeType": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "default": "system",
          "description": "%configuration.themeType.description%"
        },
        "diffPreview.view.darkTheme": {
          "type": "string",
          "default": "pierre-dark",
          "description": "%configuration.darkTheme.description%"
        },
        "diffPreview.view.lightTheme": {
          "type": "string",
          "default": "pierre-light",
          "description": "%configuration.lightTheme.description%"
        },
        "diffPreview.view.preferredHighlighter": {
          "type": "string",
          "enum": [
            "shiki-js",
            "shiki-wasm"
          ],
          "default": "shiki-js",
          "description": "%configuration.preferredHighlighter.description%"
        },
        "diffPreview.view.diffIndicators": {
          "type": "string",
          "enum": [
            "classic",
            "bars",
            "none"
          ],
          "default": "classic",
          "description": "%configuration.diffIndicators.description%"
        },
        "diffPreview.view.hunkSeparators": {
          "type": "string",
          "enum": [
            "simple",
            "metadata",
            "line-info",
            "line-info-basic"
          ],
          "default": "line-info",
          "description": "%configuration.hunkSeparators.description%"
        },
        "diffPreview.view.lineDiffType": {
          "type": "string",
          "enum": [
            "word-alt",
            "word",
            "char",
            "none"
          ],
          "default": "word",
          "description": "%configuration.lineDiffType.description%"
        },
        "diffPreview.view.lineHoverHighlight": {
          "type": "string",
          "enum": [
            "disabled",
            "both",
            "number",
            "line"
          ],
          "default": "line",
          "description": "%configuration.lineHoverHighlight.description%"
        },
        "diffPreview.view.disableLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.disableLineNumbers.description%"
        },
        "diffPreview.view.disableFileHeader": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.disableFileHeader.description%"
        },
        "diffPreview.view.disableBackground": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.disableBackground.description%"
        },
        "diffPreview.view.expandUnchanged": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.expandUnchanged.description%"
        },
        "diffPreview.view.enableLineSelection": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableLineSelection.description%"
        },
        "diffPreview.view.enableGutterUtility": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.enableGutterUtility.description%"
        },
        "diffPreview.view.useTokenTransformer": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.useTokenTransformer.description%"
        },
        "diffPreview.view.enableTokenInteractionsOnWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.enableTokenInteractionsOnWhitespace.description%"
        },
        "diffPreview.view.disableVirtualizationBuffers": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.disableVirtualizationBuffers.description%"
        },
        "diffPreview.view.stickyHeaders": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.stickyHeaders.description%"
        },
        "diffPreview.view.pointerEventsOnScroll": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.pointerEventsOnScroll.description%"
        },
        "diffPreview.view.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showToolbar.description%"
        },
        "diffPreview.view.showStats": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStats.description%"
        },
        "diffPreview.view.collapsedContextThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 1,
          "description": "%configuration.collapsedContextThreshold.description%"
        },
        "diffPreview.view.expansionLineCount": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000,
          "default": 20,
          "description": "%configuration.expansionLineCount.description%"
        },
        "diffPreview.view.maxLineDiffLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000,
          "default": 5000,
          "description": "%configuration.maxLineDiffLength.description%"
        },
        "diffPreview.view.tokenizeMaxLineLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000,
          "default": 1000,
          "description": "%configuration.tokenizeMaxLineLength.description%"
        },
        "diffPreview.view.tokenizeMaxLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000000,
          "default": 100000,
          "description": "%configuration.tokenizeMaxLength.description%"
        },
        "diffPreview.view.maxFileSizeBytes": {
          "type": "number",
          "minimum": 1,
          "maximum": 104857600,
          "default": 10485760,
          "description": "%configuration.maxFileSizeBytes.description%"
        },
        "diffPreview.view.customCss": {
          "type": "string",
          "default": "",
          "description": "%configuration.customCss.description%"
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:vscode-plugins-diff-preview.openPreview",
    "onCommand:vscode-plugins-diff-preview.openPreviewToSide",
    "onCustomEditor:vscode-plugins-diff-preview.preview"
  ],
  "engines": {
    "vscode": "^1.105.0"
  }
}
